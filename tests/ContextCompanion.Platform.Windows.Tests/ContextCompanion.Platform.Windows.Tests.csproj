<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests of the Windows implementations (DPAPI). They run on Windows; elsewhere they are reported as skipped. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>ContextCompanion.Platform.Windows.Tests</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Test framework: xUnit (Apache-2.0) with the VSTest SDK (MIT). See NOTICE. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ContextCompanion.Core\ContextCompanion.Core.csproj" />
    <ProjectReference Include="..\..\src\ContextCompanion.Platform.Windows\ContextCompanion.Platform.Windows.csproj" />
    <ProjectReference Include="..\..\src\ContextCompanion.Tool\ContextCompanion.Tool.csproj" />
  </ItemGroup>

</Project>
