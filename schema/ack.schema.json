{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/context-companion/context-companion/schema/ack.schema.json",
  "title": "context-companion consumer acknowledgement, format v1",
  "description": "The ack.json a consumer writes into a packet folder after taking the packet. It records that the packet was consumed, not that anyone read or answered it. The id must equal the packet's id. See docs/packet-format.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "id", "consumer", "consumed"],
  "properties": {
    "format": { "const": "context-companion.ack" },
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$" },
    "consumer": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "consumed": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,7})?Z$"
    },
    "note": {
      "type": "string",
      "maxLength": 1000,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f-\\u009f]*$"
    }
  }
}
