<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral core: no Windows APIs, tested on Linux and Windows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ContextCompanion.Core</RootNamespace>
  </PropertyGroup>

  <!-- Default privacy data, documented in PRIVACY.md and editable through the settings file. -->
  <ItemGroup>
    <EmbeddedResource Include="Privacy\Defaults\denylist.json" LogicalName="ContextCompanion.Core.Privacy.denylist.json" />
    <EmbeddedResource Include="Privacy\Defaults\secret-patterns.json" LogicalName="ContextCompanion.Core.Privacy.secret-patterns.json" />
    <EmbeddedResource Include="Capturing\Defaults\no-copy-window-classes.json" LogicalName="ContextCompanion.Core.Capturing.no-copy-window-classes.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ContextCompanion.Core.Tests" />
  </ItemGroup>

</Project>
