<Project Sdk="Microsoft.NET.Sdk">

  <!-- The `ccomp` command-line tool. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net10.0 runs anywhere; the net10.0-windows build adds DPAPI decryption for `ccomp open`. The Windows build
         is produced on Windows, or elsewhere with -p:EnableWindowsTargeting=true. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(OS)' == 'Windows_NT' or '$(EnableWindowsTargeting)' == 'true'">net10.0;net10.0-windows</TargetFrameworks>
    <AssemblyName>ccomp</AssemblyName>
    <RootNamespace>ContextCompanion.Tool</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContextCompanion.Core\ContextCompanion.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <ProjectReference Include="..\ContextCompanion.Platform.Windows\ContextCompanion.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
